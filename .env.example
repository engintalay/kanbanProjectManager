# --- Database ---
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me

# --- Server ---
DEBUG=False
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_HOSTS=*,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8008,http://192.168.1.5:8008

# --- Encryption key for Jira connection passwords (KEEP SECRET) ---
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Ports ---
WEB_PORT=8000
NGINX_PORT=8008

# --- One-time initial admin (optional) ---
# Sets an admin superuser on first run.
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=admin12345
